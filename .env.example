# ===== BOKARI - Configuration =====
# La plupart des configurations se font via l'interface web (Setup Wizard)
# au premier lancement sur http://localhost:3000

# Dossier de donnees (optionnel - par defaut: racine du projet)
# DATA_DIR=/chemin/vers/donnees

# ===== SUPABASE (obligatoire) =====
# NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
#    Secret JWT du projet (Dashboard > Project Settings > API > JWT Settings).
#    Utilise pour verifier les jetons de session localement (src/lib/auth/jwt.ts),
#    sans aller-retour reseau vers GoTrue a chaque requete. Sur un projet migre
#    vers des cles de signature asymetriques, laisser cette variable vide fait
#    basculer automatiquement sur le JWKS public du projet.
# SUPABASE_JWT_SECRET=
#    Note admin : le role admin ne vient plus de BOKARI_ADMIN_EMAILS mais de
#    app_metadata.role, pose une fois via le SQL editor Supabase :
#    update auth.users set raw_app_meta_data = raw_app_meta_data || '{"role":"admin"}'::jsonb where email = '...';

# ===== SECURITE =====
#    Secret partage pour les routes /api/internal/cron/[job] et
#    /api/discover/refresh. Route fermee (401) si absent.
# CRON_SECRET=
#    Secret HMAC pour l'empreinte des invites (quota anonyme, sans stocker
#    d'IP en clair). Obligatoire pour que le chat invite fonctionne.
# BOKARI_FINGERPRINT_SECRET=
#    Hotes LLM locaux autorises comme baseURL provider (ollama/lmstudio/lemonade).
#    Vide par defaut : sur un deploiement public, un baseURL local est une
#    primitive SSRF, pas une fonctionnalite.
# BOKARI_ALLOWED_LOCAL_LLM_HOSTS=

# ===== CLES API NECESSAIRES (a configurer dans l'interface) =====
#
# 1. MOTEUR DE RECHERCHE (src/lib/retrieval/ — voir CLAUDE.md chantier C4)
#    Chaine par intent, chaque provider skippe silencieusement si sa cle/URL
#    manque : general = SearXNG -> TinyFish -> Serper ; actualite = Serper (le
#    seul a renvoyer une vraie date par resultat) -> TinyFish -> SearXNG ;
#    academique = TinyFish uniquement (domain_type=research_paper).
#    - SearXNG (gratuit, local uniquement — plus de repli vers des instances
#      publiques tierces) : docker run -d -p 8080:8080 searxng/searxng
# SEARXNG_API_URL=http://localhost:8080
#    - TinyFish (gratuit, Search API illimite meme a $0 de solde) :
#      cle sur https://agent.tinyfish.ai/api-keys
# TINYFISH_API_KEY=
#    - Serper (payant, ~1$/1000 requetes, 2500 gratuites/mois) :
#      cle sur https://serper.dev
# SERPER_API_KEY=
#
# 2. PROVIDER LLM (choisir au moins un)
#    - OpenAI: https://platform.openai.com/api-keys
#    - Anthropic (Claude): https://console.anthropic.com/settings/keys
#    - Google Gemini: https://aistudio.google.com/app/apikey
#    - Groq (gratuit, rapide): https://console.groq.com/keys
#    - Ollama (local, gratuit): https://ollama.com (installer puis lancer)
#
# 3. MODELE D'EMBEDDING (optionnel mais recommande)
#    - Utilise le meme provider que le LLM dans la plupart des cas
#    - OpenAI: text-embedding-3-small (recommande)
#    - Ollama: nomic-embed-text (local, gratuit)
#
# 4. ELEVENLABS (TTS & STT - voix realiste)
#    ELEVENLABS_API_KEY=sk_votre_cle_ici
#    ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM  (optionnel, Rachel par defaut)

# ===== CONFIGURATION RECOMMANDEE POUR BOKARI =====
#
# Option 1 - Budget (gratuit):
#   LLM: Groq (llama-3.3-70b) + Embedding: Ollama (nomic-embed-text)
#
# Option 2 - Qualite maximale:
#   LLM: Anthropic Claude Sonnet 4 + Embedding: OpenAI text-embedding-3-small
#
# Option 3 - Local complet (hors-ligne):
#   LLM: Ollama (llama3.1:8b ou mistral) + Embedding: Ollama (nomic-embed-text)

# ===== MODELE DE BASE (recommande) =====
#
# Modele unique pour TOUT (chat interactif + blog/stats autonomes + fidelite +
# Learn) : DeepSeek V4 Flash via OpenRouter. Raisonnement natif (affiche dans
# les etapes de recherche), contexte 1M, tres bon marche (~0,10$/0,20$ par 1M).
# DeepSeek V4 n'a PAS d'offre gratuite -> le compte OpenRouter doit etre credite.
# Fallback = Groq (llama-3.3-70b-versatile) : fournisseur different d'OpenRouter,
# donc une panne/limite chez l'un n'affecte pas l'autre. Necessite un provider
# OpenRouter configure (Settings -> Models, ou OPENROUTER_API_KEY) et un
# provider Groq configure (GROQ_API_KEY) pour que le fallback fonctionne.
BOKARI_CHAT_PROVIDER=openrouter
BOKARI_CHAT_MODEL=deepseek/deepseek-v4-flash
BOKARI_CHAT_FALLBACK_PROVIDER=groq
BOKARI_CHAT_FALLBACK_MODEL=llama-3.3-70b-versatile

# ===== OPTIMISATIONS MOTEUR (optionnel, opt-in) =====
#
# 1. ROUTAGE PAR TIER DE MODELE (vitesse + cout)
#    Les requetes simples passent sur un modele rapide (ex. Groq Llama 3.1 8B),
#    les complexes restent sur le 70B par defaut. Pointer vers un provider/modele
#    deja configure. Si absent ou indisponible -> tout reste sur le modele par defaut.
# BOKARI_FAST_CHAT_PROVIDER_ID=<provider-id-configure>
# BOKARI_FAST_CHAT_KEY=llama-3.1-8b-instant
#
# 2. GARDE DE FIDELITE DES CITATIONS - NLI (confiance)
#    Apres la reponse, chaque affirmation citee est verifiee contre sa source et
#    recoit un verdict (soutenue / partielle / non soutenue). Desactive par defaut.
# BOKARI_FAITHFULNESS_ENABLED=true
#
# 3. CACHE SEMANTIQUE MULTILINGUE
#    Seuil cosinus (defaut 0.90). Baisser vers ~0.88 augmente le rappel sur les
#    paraphrases FR/africaines ; monter favorise la precision.
# BOKARI_CACHE_COSINE_THRESHOLD=0.90
#
# 4. RECHERCHE SOCIALE (X / Reddit / LinkedIn) - opt-in par reseau
#    Master switch (defaut true). A false => tout reste sur la voie "site"
#    (operateur site: + scraper multi-moteurs), zero-config fonctionne.
# BOKARI_SOCIAL_SEARCH_ENABLED=true
#    Provider par reseau: "site" (gratuit, defaut) ou "brightdata" (premium).
#    "brightdata" retombe sur "site" si la cle/dataset manque.
# X_SEARCH_PROVIDER=site
# REDDIT_SEARCH_PROVIDER=site
# LINKEDIN_SEARCH_PROVIDER=site
#    Bright Data Web Scraper API (une seule cle Bearer pour tous les datasets).
# BRIGHTDATA_API_KEY=
#    IDs de dataset gd_... (pilotes par env => echangeables sans deploiement).
# BRIGHTDATA_DS_X_POSTS=gd_lwxkxvnf1cynvib9co
# BRIGHTDATA_DS_REDDIT_POSTS=gd_lvz8ah06191smkebj4
# BRIGHTDATA_DS_LINKEDIN_POSTS=gd_lyy3tktm25m4avu764
#    Cadence/budget du polling snapshot (ms) et TTL du cache social (ms).
# BRIGHTDATA_POLL_INTERVAL_MS=4000
# BRIGHTDATA_POLL_TIMEOUT_MS=45000
# BOKARI_SOCIAL_CACHE_TTL_MS=1800000
#
# 5. YOUTUBE (recherche video + comprehension de transcript) - opt-in
#    Master switch recherche (defaut true). A false => voie "scrape" (gratuit,
#    site:youtube.com via DuckDuckGo), zero-config fonctionne sans cle.
# BOKARI_YOUTUBE_SEARCH_ENABLED=true
#    Provider de recherche: "scrape" (gratuit, defaut), "api" (YouTube Data
#    API v3, selectionne automatiquement si YOUTUBE_API_KEY est defini), ou
#    "brightdata". Sur 403/quota/erreur, retombe sur "scrape".
# YOUTUBE_SEARCH_PROVIDER=scrape
# YOUTUBE_API_KEY=
#    Dataset video Bright Data (recherche par mot-cle + transcript natif).
# BRIGHTDATA_DS_YOUTUBE_VIDEOS=gd_lk56epmy2i5g7lzu0k
#    Comprehension de transcript (chaine: Bright Data -> youtubei.js InnerTube
#    -> API geree -> ElevenLabs STT). Comprehend desactive par defaut.
# BOKARI_YOUTUBE_COMPREHEND_ENABLED=false
#    API geree de transcript (optionnelle).
# TRANSCRIPT_API_KEY=
# TRANSCRIPT_API_URL=
#    STT audio ElevenLabs scribe_v1 (voie Wolof/Bambara/Hausa, LENTE, opt-in).
#    Reutilise ELEVENLABS_API_KEY. Doit rester sur la voie async (job store).
# BOKARI_YOUTUBE_STT_ENABLED=false
#    TTL des caches YouTube (recherche + transcript), en ms.
# BOKARI_YOUTUBE_CACHE_TTL_MS=1800000
# BOKARI_TRANSCRIPT_CACHE_TTL_MS=1800000
